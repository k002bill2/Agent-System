# Agent Orchestration Service - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# LLM Provider Configuration (choose one)
# =============================================================================

# Provider: codex_cli (default), openai, google, anthropic, or ollama
LLM_PROVIDER=codex_cli

# Codex CLI (default, ChatGPT subscription-backed)
# Run `codex` once and sign in with ChatGPT before starting the backend.
# CODEX_CLI_COMMAND=codex
# CODEX_CLI_ARGS=exec --sandbox read-only --color never
# CODEX_CLI_TIMEOUT_SECONDS=300

# OpenAI API (usage-billed alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude API (alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# =============================================================================
# External LLM Usage Monitoring (External Usage dashboard)
# =============================================================================
# ORG-LEVEL ADMIN keys for reading aggregated usage/cost. These are SEPARATE
# from the chat API keys above and from any key registered in the UI: the
# External Usage page collects data ONLY from these env vars. A key stored via
# the LLM Credentials UI lights up the "configured" badge but does NOT feed
# usage collection — set the matching variable here too.
# OpenAI: requires an Admin key (sk-admin-...) with the api.usage.read scope;
# a regular sk-... / sk-proj-... project key cannot read org usage.
# EXTERNAL_OPENAI_ADMIN_KEY=sk-admin-...
# EXTERNAL_ANTHROPIC_ADMIN_KEY=sk-ant-admin...
# EXTERNAL_GITHUB_TOKEN=ghp_...
# EXTERNAL_GITHUB_ORG=my-org

# =============================================================================
# OAuth Authentication (optional - for multi-user setup)
# =============================================================================

# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# Security (change in production!)
# =============================================================================

# JWT Secret Key - REQUIRED.
# Leave empty: ./setup.sh auto-generates a strong value.
# Manual: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# First-admin bootstrap: comma-separated emails granted admin role.
# OAuth users are promoted on first login; email/password users on their
# next login after registering (see docs/self-host-quickstart.md).
SUPER_ADMIN_EMAILS=

# Field Encryption (hex-encoded 32-byte key, generate with: python -c "import os; print(os.urandom(32).hex())")
# Leave empty to disable field encryption (plaintext storage)
# ENCRYPTION_MASTER_KEY=

# =============================================================================
# Database (auto-configured by docker-compose)
# =============================================================================

# Postgres credentials used by docker-compose to provision the DB container
# and to build the in-container DATABASE_URL. POSTGRES_PASSWORD is REQUIRED;
# leave empty and ./setup.sh auto-generates a strong value on a fresh install.
POSTGRES_USER=aos
POSTGRES_PASSWORD=
POSTGRES_DB=aos

# Direct DATABASE_URL for local (non-docker) development only.
# docker-compose ignores this and builds the URL from POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://aos:aos@localhost:5432/aos

REDIS_URL=redis://localhost:6379/0
USE_DATABASE=true

# Database TLS (optional)
# DB_SSL_MODE=require  # require, verify-ca, verify-full
# DB_SSL_CERT_PATH=

# Redis TLS (optional)
# REDIS_SSL=false

# =============================================================================
# Server Configuration
# =============================================================================

HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Frontend URL (for OAuth callbacks).
# Remote self-host: set to the externally reachable dashboard URL
# (e.g. http://<server-ip>:5173 or https://aos.example.com), NOT localhost.
FRONTEND_URL=http://localhost:5173

# CORS - 아래 두 형식 모두 지원:
#   쉼표 구분: http://localhost:3000,http://localhost:5173
#   JSON 배열: '["http://localhost:3000","http://localhost:5173"]'  (shell source 시 single-quote 필수)
# Remote self-host: include the same externally reachable URL as FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Claude Code Usage Monitoring (optional)
# =============================================================================

# OAuth token priority: 1) Dashboard Settings 2) env var 3) macOS Keychain
# Local dev: Keychain auto-detected, no config needed
# Deployment (Docker/Linux): set env var or use Dashboard Settings
# CLAUDE_OAUTH_TOKEN=your_oauth_token_here

# =============================================================================
# Orchestration
# =============================================================================

MAX_ITERATIONS=100
# Model selection is managed via DB (llm_model_configs table). No model env vars needed.
# To change the default model, use PATCH /api/llm/models/{model_id} endpoint.

# =============================================================================
# Claude Code Agent Teams (experimental)
# =============================================================================

CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
CLAUDE_CODE_TEAMMATE_MODE=tmux

# =============================================================================
# RAG Configuration (Playground + project context retrieval)
# =============================================================================

# Hybrid search: BM25 + semantic with RRF fusion (requires rank_bm25)
RAG_ENABLE_HYBRID=true
# CrossEncoder reranking of fused candidates (requires sentence-transformers)
RAG_ENABLE_RERANK=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking: files under threshold kept as single chunk
RAG_FULL_CONTEXT_THRESHOLD=8000
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=300
# Semantic candidate pool multiplier before fusion (k * multiplier)
RAG_CANDIDATE_MULTIPLIER=3

# Embedding model — multilingual + code aware
# Alternatives: sentence-transformers/all-MiniLM-L6-v2 (en only, 384d),
#               intfloat/multilingual-e5-large (1024d)
EMBEDDING_PROVIDER=huggingface
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Device for HuggingFace embeddings: cpu | mps | cuda
# macOS PyTorch MPS deadlocks with uvloop on long indexing runs — keep cpu
RAG_EMBEDDING_DEVICE=cpu
# Sentence-transformers encode batch size; 64 is ~2x faster than the default 32
RAG_EMBEDDING_BATCH_SIZE=64

# =============================================================================
# Web Search Tool (Playground)
# =============================================================================

# Tavily search API key — get one at https://tavily.com
# Falls back to DuckDuckGo Instant Answer when empty
TAVILY_API_KEY=

# =============================================================================
# Docker Port Overrides (optional - use when default ports conflict)
# =============================================================================

# PG_PORT=5433           # PostgreSQL (default: 5432)
# REDIS_PORT=6380        # Redis (default: 6379)
# BACKEND_PORT=8001      # Backend API (default: 8000)
# DASHBOARD_PORT=5174    # Dashboard (default: 5173)
# QDRANT_PORT=6335       # Qdrant REST (default: 6333)
# QDRANT_GRPC_PORT=6336  # Qdrant gRPC (default: 6334)
