# Environment
.env
.env.local
.env.*.local

# Secrets / keys (defense-in-depth — never commit)
*.pem
id_rsa*
*credentials*

# Local review artifacts (worktree review internals, not for the public repo)
.review-artifacts/

# Maintainer-local Compose overrides (host-specific bind mounts; never shipped)
docker-compose.override.yml

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Screenshots (root level)
/*.png

# Logs
logs/
*.log

# Database backups
*.dump
infra/backups/
*.rdb
*.snapshot

# PostgreSQL local data (bind mount) and pre-shutdown backups
infra/docker/data/postgres/
infra/docker/data/backups/

# Backend data (playground sessions, etc.)
src/backend/data/

# Runtime
.pids/

# Playwright
.playwright-mcp/

# Cache
.cache/
*.swp

# Projects (symlinks - managed separately)
projects/*
!projects/.gitkeep
src/dashboard/coverage/

# Git worktrees
.worktrees/
.claude/worktrees/

# Claude Code transient files
.claude/evals/results/
.claude/coordination/
.claude/plans/
.claude/hooks/.context-state.json
.claude/snapshots/
.claude/scheduled_tasks.lock

# Nested .claude/ runtime artifacts (e.g. src/backend/.claude/, src/dashboard/.claude/)
**/.claude/coordination/
**/.claude/snapshots/
.temp/

# TypeScript incremental build cache
*.tsbuildinfo

# Dev docs (in-progress work)
dev/active/

# Deprecated architecture diagram (replaced by claude-code-system-architecture.html)
docs/claude-code-architecture-diagram.html
.serena/
.gstack/

# Benchmark outputs — host-specific absolute paths, not reproducible
scripts/bench_results/

# Harness audit/diet artifacts — local security-assessment internals, not for the public repo
dev/harness-legacy-scan/
.claude/archive/
.claude/workflows/

# Local AI-tooling config (Codex CLI / agent mirrors) — machine-specific, has absolute paths
# AGENTS.md is intentionally NOT ignored (portable public doc, mirror of CLAUDE.md)
.agents/
.codex/
# 외부 도구가 작업 디렉토리에 떨구는 빈 설정 파일. 레포 내 소비자 0건(실측 2026-08-09)인데
# pre-commit 훅이 무관한 커밋에 쓸어 담은 사례가 있어(B4) 아예 시야에서 제외한다.
paseo.json

# Harness intermediate artifacts (aos-feature-harness) — audit trail, not committed
_workspace/
_workspace_*/

# Hermes 에이전트 작업 디렉토리 — 진행 중 계획서 등 산출물. `.claude/plans/` ·
# `dev/active/` 와 같은 성격이라 추적하지 않는다. 남길 가치가 있는 계획은
# `docs/plans/` 로 옮긴다.
.hermes/

# AOS 런타임이 직접 쓰는 프로젝트별 로컬 메타데이터 (머신 종속)
.aos-project.json

# 세션 프로브·일회성 스크립트 잔재. 레포 루트에 쌓이기만 하고 커밋 대상이 아니다.
.scratch/
